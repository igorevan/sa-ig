       fhir:ElementDefinition.definition [ fhir:value "Sumário de Alta Hospitalar" ] ;
       fhir:ElementDefinition.comment [ fhir:value "While the focus of this specification is on patient-specific clinical statements, this resource can also apply to other healthcare-related statements such as study protocol designs, healthcare invoices and other activities that are not necessarily patient-specific or clinical." ] ;
       fhir:ElementDefinition.alias [
