     fhir:CodeSystem.concept.display [ fhir:value "Angioedema" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Edema súbito da derme, tecido subcutâneo, mucosa e tecido submucoso." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10003246" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Artrite" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Inflamação numa ou mais articulações." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10003553" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Asma" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Asma é uma doença inflamatória das vias aéreas." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10006482" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Broncoespasmo" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Estreitamento do lúmen brônquico, em consequência da contração da musculatura brônquica." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10010741" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Conjuntivite" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Inflamação da conjuntiva." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10003639" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Dermatite atópica" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Caracteriza-se pela presença de erupções pruriginosas e com crosta." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10012442" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Dermatite de contato" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Reação inflamatória que ocorre devido ao contato da pele com um agente irritante." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10012735" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Diarréia" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Evacuação de fezes líquidas de forma frequente e sem controle, podendo ser aguda ou crônica" ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10013968" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Dispnéia" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "É uma sensação de dificuldade em respirar." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10014184" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Eczema" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Tipo de inflamação cutânea." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10023845" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Edema de Glote" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Edema súbito da glote que impede a passagem de ar." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10015218" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Eritema Multiforme" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Reação imunológica da pele e mucosas." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10012441" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Exantema bolhoso" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Erupção cutânea constituída por bolhas." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10037868" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Exantema maculopapular" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Erupção cutânea que se caracteriza pelo aparecimento de manchas e pápulas eritematosas." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10034972" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Fotossensibilidade" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Queimaduras ou outras reações cutâneas desencadeadas pela exposição aos raios ultravioleta." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10028116" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Mucosite" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "A mucosite é uma inflamação da mucosa do tubo digestivo." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10029117" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Nefrite" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Processo inflamatório localizado ao rim." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10007617" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Parada Cardiorespiratória" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Interrupção súbita da circulação sanguínea e dos movimentos respiratórios." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10037087" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Prurido" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Sensação de irritação intensa da pele, que induz a coceira." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10039083" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Rinite" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Irritação e inflamação crônica ou aguda da mucosa nasal." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10073508" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Síndrome de DRESS" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Reação adversa sistêmica a um fármaco, consistindo em erupções cutâneas graves, febre, adenopatias, hepatite e alterações hematológicas (hipereosinofilia e linfocitose atípica)." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10044223" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Síndrome de Lyell" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Lesão dermatológica rara, de extrema gravidade, caracterizada pelo aparecimento súbito de febre elevada, sinais de toxicidade sistémica e exfoliação mucocutânea intensa." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10042033" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Síndrome de Stevens-Johnson" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Erupções cutâneas generalizadas, febre, mucosite oral e conjuntivite purulenta graves." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10011224" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Tosse" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Resposta reflexa ou voluntária do organismo, resultante de irritação das vias áreas e que funciona como uma contração espasmódica e normalmente repetitiva, do tórax." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10046735" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Urticária" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Tipo de erupção cutânea, pruriginosa, caracterizada por placas salientes, que se assemelham às produzidas pela urtiga." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10047115" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Vasculite" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Inflamação vascular, que pode estender-se ao endotélio, causando estenose e/ou oclusão." ]
  ], [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10047700" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Vômito" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "É a expulsão ativa do conteúdo gástrico pela boca." ]
  ] .

