  fhir:CodeSystem.concept [
     fhir:index -1 ;
     fhir:CodeSystem.concept.code [ fhir:value "10002198" ] ;
     fhir:CodeSystem.concept.display [ fhir:value "Anafilaxia" ] ;
     fhir:CodeSystem.concept.definition [ fhir:value "Anafilaxia é uma reação alérgica aguda e grave que começa subitamente, entre menos de um minuto e até algumas horas após a exposição a um alérgeno, ao qual a pessoa desenvolveu hipersensibilidade, e que pode ser fatal." ]
  ], [
     fhir:index -1 ;
