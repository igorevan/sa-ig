     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xml:lang=\"pt-BR\" xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"pt-BR\"><p class=\"res-header-id\"><b>Narrativa gerada: CodeSystem BRTipoIdentificador</b></p><a name=\"BRTipoIdentificador\"> </a><a name=\"hcBRTipoIdentificador\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\">Língua: pt-BR</p></div><p><b>Propriedades</b></p><p><b>Este sistema de códigos define as seguintes propriedades para os seus conceitos</b></p><table class=\"grid\"><tr><td><b>Nome</b></td><td><b>Código</b></td><td><b>Tipo</b></td><td><b>Descrição</b></td></tr><tr><td>use</td><td>use</td><td>string</td><td>Uso do Tipo do Identificador</td></tr></table><p><b>Conceitos</b></p><p>Este case-sensitive sistema de código <code>http://www.saude.gov.br/fhir/r4/CodeSystem/BRTipoIdentificador</code> define o seguinte códigos:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Código</b></td><td><b>Ecrã</b></td><td><b>Definição</b></td><td><b>use</b></td></tr><tr><td style=\"white-space:nowrap\">AUTH<a name=\"BRTipoIdentificador-AUTH\"> </a></td><td>Código de Autorização</td><td>Identificador da permissão para a realização de um procedimento.</td><td>procedure</td></tr><tr><td style=\"white-space:nowrap\">BRACRA<a name=\"BRTipoIdentificador-BRACRA\"> </a></td><td>Número de inscrição no Conselho Regional de Administração (CRA)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACRESS<a name=\"BRTipoIdentificador-BRACRESS\"> </a></td><td>Número de inscrição no Conselho Regional de Serviço Social (CRESS)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACRB<a name=\"BRTipoIdentificador-BRACRB\"> </a></td><td>Número de inscrição no Conselho Regional de Biblioteconomia (CRB)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACRC<a name=\"BRTipoIdentificador-BRACRC\"> </a></td><td>Número de inscrição no Conselho Regional de Contabilidade (CRC)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACRECI<a name=\"BRTipoIdentificador-BRACRECI\"> </a></td><td>Número de inscrição no Conselho Regional de Corretores de Imóveis (CRECI)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACORECON<a name=\"BRTipoIdentificador-BRACORECON\"> </a></td><td>Número de inscrição no Conselho Regional de Economia (CORECON)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACREA<a name=\"BRTipoIdentificador-BRACREA\"> </a></td><td>Número de inscrição no Conselho Regional de Engenharia e Agronomia (CREA)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACONFRE<a name=\"BRTipoIdentificador-BRACONFRE\"> </a></td><td>Número de inscrição no Conselho Regional de Estatística (CONRE)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACRF<a name=\"BRTipoIdentificador-BRACRF\"> </a></td><td>Número de inscrição no Conselho Regional de Farmácia (CRF)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACREFITO<a name=\"BRTipoIdentificador-BRACREFITO\"> </a></td><td>Número de inscrição no Conselho Regional de Fisioterapia e Terapia Ocupacional (CREFITO)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACRMV<a name=\"BRTipoIdentificador-BRACRMV\"> </a></td><td>Número de inscrição no Conselho Regional de Medicina Veterinária (CRMV)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACRN<a name=\"BRTipoIdentificador-BRACRN\"> </a></td><td>Número de inscrição no Conselho Regional de Nutrição (CRN)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACONRERP<a name=\"BRTipoIdentificador-BRACONRERP\"> </a></td><td>Número de inscrição no Conselho Regional de Reçações Públicas (CONRERP)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACRP<a name=\"BRTipoIdentificador-BRACRP\"> </a></td><td>Número de inscrição no Conselho Regional de Psicologia (CRP)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACRQ<a name=\"BRTipoIdentificador-BRACRQ\"> </a></td><td>Número de inscrição no Conselho Regional de Química (CRQ)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACORE<a name=\"BRTipoIdentificador-BRACORE\"> </a></td><td>Número de inscrição no Conselho Regional de Representantes Comerciais (CORE)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACREF<a name=\"BRTipoIdentificador-BRACREF\"> </a></td><td>Número de inscrição no Conselho Regional de Educação Física (CREF)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACAU<a name=\"BRTipoIdentificador-BRACAU\"> </a></td><td>Número de inscrição no Conselho Regional de Arquitetura e Urbanismo (CAU)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACRBIO<a name=\"BRTipoIdentificador-BRACRBIO\"> </a></td><td>Número de inscrição no Conselho Regional de Biologia (CRBio)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACRBM<a name=\"BRTipoIdentificador-BRACRBM\"> </a></td><td>Número da inscrição no Conselho Regional de Biomedicina (CRBM)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACRFA<a name=\"BRTipoIdentificador-BRACRFA\"> </a></td><td>Número da inscrição no Conselho Regional de Fonoaudiologia (CRFa/CREFONO)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACRTR<a name=\"BRTipoIdentificador-BRACRTR\"> </a></td><td>Número da inscrição no Conselho Regional de Técnicos em Radiologia (CRTR)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRACRT<a name=\"BRTipoIdentificador-BRACRT\"> </a></td><td>Número da inscrição no Conselho Regional dos Técnicos Industriais (CRT)</td><td/><td>patient</td></tr><tr><td style=\"white-space:nowrap\">BRAOAB<a name=\"BRTipoIdentificador-BRAOAB\"> </a></td><td>Número de inscrição na Ordem dos Advogados do