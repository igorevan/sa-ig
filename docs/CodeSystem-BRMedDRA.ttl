  fhir:Resource.language [ fhir:value "pt-BR"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xml:lang=\"pt-BR\" xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"pt-BR\"><p class=\"res-header-id\"><b>Narrativa gerada: CodeSystem BRMedDRA</b></p><a name=\"BRMedDRA\"> </a><a name=\"hcBRMedDRA\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\">Última atualização: 2022-12-02 15:35:49+0000; Língua: pt-BR</p></div><p>Este case-sensitive sistema de código <code>http://www.saude.gov.br/fhir/r4/CodeSystem/BRMedDRA</code> define o seguinte códigos:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Código</b></td><td><b>Ecrã</b></td><td><b>Definição</b></td></tr><tr><td style=\"white-space:nowrap\">10002198<a name=\"BRMedDRA-10002198\"> </a></td><td>Anafilaxia</td><td>Anafilaxia é uma reação alérgica aguda e grave que começa subitamente, entre menos de um minuto e até algumas horas após a exposição a um alérgeno, ao qual a pessoa desenvolveu hipersensibilidade, e que pode ser fatal.</td></tr><tr><td style=\"white-space:nowrap\">10002424<a name=\"BRMedDRA-10002424\"> </a></td><td>Angioedema</td><td>Edema súbito da derme, tecido subcutâneo, mucosa e tecido submucoso.</td></tr><tr><td style=\"white-space:nowrap\">10003246<a name=\"BRMedDRA-10003246\"> </a></td><td>Artrite</td><td>Inflamação numa ou mais articulações.</td></tr><tr><td style=\"white-space:nowrap\">10003553<a name=\"BRMedDRA-10003553\"> </a></td><td>Asma</td><td>Asma é uma doença inflamatória das vias aéreas.</td></tr><tr><td style=\"white-space:nowrap\">10006482<a name=\"BRMedDRA-10006482\"> </a></td><td>Broncoespasmo</td><td>Estreitamento do lúmen brônquico, em consequência da contração da musculatura brônquica.</td></tr><tr><td style=\"white-space:nowrap\">10010741<a name=\"BRMedDRA-10010741\"> </a></td><td>Conjuntivite</td><td>Inflamação da conjuntiva.</td></tr><tr><td style=\"white-space:nowrap\">10003639<a name=\"BRMedDRA-10003639\"> </a></td><td>Dermatite atópica</td><td>Caracteriza-se pela presença de erupções pruriginosas e com crosta.</td></tr><tr><td style=\"white-space:nowrap\">10012442<a name=\"BRMedDRA-10012442\"> </a></td><td>Dermatite de contato</td><td>Reação inflamatória que ocorre devido ao contato da pele com um agente irritante.</td></tr><tr><td style=\"white-space:nowrap\">10012735<a name=\"BRMedDRA-10012735\"> </a></td><td>Diarréia</td><td>Evacuação de fezes líquidas de forma frequente e sem controle, podendo ser aguda ou crônica</td></tr><tr><td style=\"white-space:nowrap\">10013968<a name=\"BRMedDRA-10013968\"> </a></td><td>Dispnéia</td><td>É uma sensação de dificuldade em respirar.</td></tr><tr><td style=\"white-space:nowrap\">10014184<a name=\"BRMedDRA-10014184\"> </a></td><td>Eczema</td><td>Tipo de inflamação cutânea.</td></tr><tr><td style=\"white-space:nowrap\">10023845<a name=\"BRMedDRA-10023845\"> </a></td><td>Edema de Glote</td><td>Edema súbito da glote que impede a passagem de ar.</td></tr><tr><td style=\"white-space:nowrap\">10015218<a name=\"BRMedDRA-10015218\"> </a></td><td>Eritema Multiforme</td><td>Reação imunológica da pele e mucosas.</td></tr><tr><td style=\"white-space:nowrap\">10012441<a name=\"BRMedDRA-10012441\"> </a></td><td>Exantema bolhoso</td><td>Erupção cutânea constituída por bolhas.</td></tr><tr><td style=\"white-space:nowrap\">10037868<a name=\"BRMedDRA-10037868\"> </a></td><td>Exantema maculopapular</td><td>Erupção cutânea que se caracteriza pelo aparecimento de manchas e pápulas eritematosas.</td></tr><tr><td style=\"white-space:nowrap\">10034972<a name=\"BRMedDRA-10034972\"> </a></td><td>Fotossensibilidade</td><td>Queimaduras ou outras reações cutâneas desencadeadas pela exposição aos raios ultravioleta.</td></tr><tr><td style=\"white-space:nowrap\">10028116<a name=\"BRMedDRA-10028116\"> </a></td><td>Mucosite</td><td>A mucosite é uma inflamação da mucosa do tubo digestivo.</td></tr><tr><td style=\"white-space:nowrap\">10029117<a name=\"BRMedDRA-10029117\"> </a></td><td>Nefrite</td><td>Processo inflamatório localizado ao rim.</td></tr><tr><td style=\"white-space:nowrap\">10007617<a name=\"BRMedDRA-10007617\"> </a></td><td>Parada Cardiorespiratória</td><td>Interrupção súbita da circulação sanguínea e dos movimentos respiratórios.</td></tr><tr><td style=\"white-space:nowrap\">10037087<a name=\"BRMedDRA-10037087\"> </a></td><td>Prurido</td><td>Sensação de irritação intensa da pele, que induz a coceira.</td></tr><tr><td style=\"white-space:nowrap\">10039083<a name=\"BRMedDRA-10039083\"> </a></td><td>Rinite</td><td>Irritação e inflamação crônica ou aguda da mucosa nasal.</td></tr><tr><td style=\"white-space:nowrap\">10073508<a name=\"BRMedDRA-10073508\"> </a></td><td>Síndrome de DRESS</td><td>Reação adversa sistêmica a um fármaco, consistindo em erupções cutâneas graves, febre, adenopatias, hepatite e alterações hematológicas (hipereosinofilia e linfocitose atípica).</td></tr><tr><td style=\"white-space:nowrap\">10044223<a name=\"BRMedDRA-10044223\"> </a></td><td>Síndrome de Lyell</td><td>Lesão dermatológica rara, de extrema gravidade, caracterizada pelo aparecimento súbito de febre elevada, sinais de toxicidade sistémica e exfoliação mucocutânea intensa.</td></tr><tr><td style=\"white-space:nowrap\">10042033<a name=\"BRMedDRA-10042033\"> </a></td><td>Síndrome de Stevens-Johnson</td><td>Erupções cutâneas generalizadas, febre, mucosite oral e conjuntivite purulenta graves.</td></tr><tr><td style=\"white-space:nowrap\">10011224<a name=\"BRMedDRA-10011224\"> </a></td><td>Tosse</td><td>Resposta reflexa ou voluntária do organismo, resultante de irritação das vias áreas e que funciona como uma contração espasmódica e normalmente repetitiva, do tórax.</td></tr><tr><td style=\"white-space:nowrap\">10046735<a name=\"BRMedDRA-10046735\"> </a></td><td>Urticária</td><td>Tipo de erupção cutânea, pruriginosa, caracterizada por placas salientes, que se assemelham às produzidas pela urtiga.</td></tr><tr><td style=\"white-space:nowrap\">10047115<a name=\"BRMedDRA-10047115\"> </a></td><td>Vasculite</td><td>Inflamação vascular, que pode estender-se ao endotélio, causando estenose e/ou oclusão.</td></tr><tr><td style=\"white-space:nowrap\">10047700<a name=\"BRMedDRA-10047700\"> </a></td><td>Vômito</td><td>É a expulsão ativa do conteúdo gástrico pela boca.</td></tr></table></div>"
  ] ;
