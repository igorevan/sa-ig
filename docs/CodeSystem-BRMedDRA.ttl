<https://fhir.saude.gov.br/sa/CodeSystem/BRMedDRA> a fhir:CodeSystem ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "BRMedDRA"] ;
  fhir:Resource.meta [
     fhir:Meta.lastUpdated [ fhir:value "2022-12-02T15:35:49.359189+00:00"^^xsd:dateTime ]
